  "sources": [
    {
      "aliases": [
        "D1"
      ],
      "display_revision": "r1",
      "original_hash": "27031d3c3f3a390ac31099815ba143cd1ae0857a84eb4b946fcf02d8d118d2bd",
      "parser_identity": "synthetic-native-text-v1",
      "process_id": "D-product",
      "reading_hash": "27031d3c3f3a390ac31099815ba143cd1ae0857a84eb4b946fcf02d8d118d2bd",
      "scope": "licensed/unlicensed",
      "source_id": "D1",
      "source_revision": 1,
      "split": "development",
      "text": "Intake starts the request. Design prepares artwork. Licensed requests require Rights approval before Sample; unlicensed requests go directly from Design to Sample. Sample acceptance is required before Production."
    },
    {
      "aliases": [
        "D2"
      ],
      "display_revision": "r1",
      "original_hash": "efbefc431aefd67c0189d820335d0eacf65694243bcc6d355583d282b1a54a8a",
      "parser_identity": "synthetic-native-text-v1",
      "process_id": "D-product",
      "reading_hash": "efbefc431aefd67c0189d820335d0eacf65694243bcc6d355583d282b1a54a8a",
      "scope": "licensed/unlicensed",
      "source_id": "D2",
      "source_revision": 1,
      "split": "development",
      "text": "A failed Sample returns to a second Design occurrence with a new revision; that revised artwork must receive a second Rights approval when licensed, before another Sample. Production ends the accepted request."
    },
    {
      "aliases": [
        "D3"
      ],
      "display_revision": "r1",
      "original_hash": "854da60702d1a58a16fdcfa21eabc686900d1e5fe0d7542a91607057098cfc56",
      "parser_identity": "synthetic-native-text-v1",
      "process_id": "D-supply",
      "reading_hash": "854da60702d1a58a16fdcfa21eabc686900d1e5fe0d7542a91607057098cfc56",
      "scope": "supplier-A",
      "source_id": "D3",
      "source_revision": 1,
      "split": "development",
      "text": "Design hands artwork revision ART-D-17 to Supplier-A. Supplier-A cannot begin tooling until ART-D-17 arrives. Design owns the handoff; Supplier-A owns tooling."
    },
    {
      "aliases": [
        "V1"
      ],
      "display_revision": "r1",
      "original_hash": "df6ad155ff1743107f9ca7febe4f04da0c104b29f8e40d242e8e73799ae8c7de",
      "parser_identity": "synthetic-native-text-v1",
      "process_id": "V-packaging",
      "reading_hash": "df6ad155ff1743107f9ca7febe4f04da0c104b29f8e40d242e8e73799ae8c7de",
      "scope": "customer-C;2026-01-01/2026-12-31",
      "source_id": "V1",
      "source_revision": 1,
      "split": "validation",
      "text": "Packaging begins at Copy preparation. Content review and Safety review run in parallel. Shipping release waits for both approvals. Rejected Content returns to a new Copy revision and another Content review. For customer-C in 2026, Content Manager must approve Shipping release."
    },
    {
      "aliases": [
        "V2"
      ],
      "display_revision": "r1",
      "original_hash": "777c07fc2a4bb086c3c9148b81aa393ec8982a84dd3b9bf379df4573a84e0d96",
      "parser_identity": "synthetic-native-text-v1",
      "process_id": "V-packaging",
      "reading_hash": "777c07fc2a4bb086c3c9148b81aa393ec8982a84dd3b9bf379df4573a84e0d96",
      "scope": "customer-C;2026-01-01/2026-12-31",
      "source_id": "V2",
      "source_revision": 1,
      "split": "validation",
      "text": "For customer-C in 2026, only Safety Manager may approve Shipping release; Content Manager must not approve it."
    },
    {
      "aliases": [
        "V3"
      ],
      "display_revision": "r1",
      "original_hash": "1e6d9c080850a24a17651347e796e14c02a183fb29ddb5b93c751be4fd56ae76",
      "parser_identity": "synthetic-native-text-v1",
      "process_id": "V-packaging",
      "reading_hash": "1e6d9c080850a24a17651347e796e14c02a183fb29ddb5b93c751be4fd56ae76",
      "scope": "customer-Z;2026-01-01/2026-12-31",
      "source_id": "V3",
      "source_revision": 1,
      "split": "validation",
      "text": "For customer-Z in 2026, Content Manager must approve Shipping release."
    },
    {
      "aliases": [
        "V4"
      ],
      "display_revision": "r1",
      "original_hash": "45023761f97a1ad37a580f767ef618571a6e410463a30bf7309b37e4309edd46",
      "parser_identity": "synthetic-native-text-v1",
      "process_id": "V-partial",
      "reading_hash": "45023761f97a1ad37a580f767ef618571a6e410463a30bf7309b37e4309edd46",
      "scope": "customer-Q",
      "source_id": "V4",
      "source_revision": 1,
      "split": "validation",
      "text": "Content review and Safety review are mentioned. The source does not specify whether Shipping release waits for either or both reviews. Shipping owner is not specified."
    },
    {
      "aliases": [
        "V5",
        "V5-upload-alias"
      ],
      "display_revision": "r1",
      "original_hash": "24f8cf3a0f4864a93b1ce4f830dd28dce8bab0fd91fb4a351d65d2f14d254d7e",
      "parser_identity": "synthetic-native-text-v1",
      "process_id": "V-labels",
      "reading_hash": "24f8cf3a0f4864a93b1ce4f830dd28dce8bab0fd91fb4a351d65d2f14d254d7e",
      "scope": "supplier-N",
      "source_id": "V5",
      "source_revision": 1,
      "split": "validation",
      "text": "Reviewer is the supplier-N inspection role. Reviewer accepts inspection record REC-V-N. Reviewer then performs a second review of its correction."
    },
    {
      "aliases": [
        "V6"
      ],
      "display_revision": "r1",
      "original_hash": "922e892c72fd73b81a1fb29b04bd8801c174091b27fe2181e5ce5f471df5a3ec",
      "parser_identity": "synthetic-native-text-v1",
      "process_id": "V-labels",
      "reading_hash": "922e892c72fd73b81a1fb29b04bd8801c174091b27fe2181e5ce5f471df5a3ec",
      "scope": "supplier-S",
      "source_id": "V6",
      "source_revision": 1,
      "split": "validation",
      "text": "Reviewer is the supplier-S billing role. Reviewer checks invoice INV-V-S. This role is distinct from supplier-N inspection."
    },
    {
      "aliases": [
        "V7"
      ],
      "display_revision": "r1",
      "original_hash": "ee902495e54bfd4ddf2fce2288018e40ba5cdb1c5605e9a07ca1c3b91fc91824",
      "parser_identity": "synthetic-native-text-v1",
      "process_id": "V-access",
