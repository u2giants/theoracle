{
  "mcpServers": {
    "supabase-oracle": {
      "command": "cmd",
      "args": [
        "/c",
        "${USERPROFILE}\\.config\\ai-devops\\mcp-launch.cmd",
        "node",
        "--input-type=module",
        "--eval",
        "const r=process.env.CLAUDE_PROJECT_DIR;if(!r)throw Error('Oracle MCP project root unavailable');const u=await import('node:url');const p=await import('node:path');const m=await import(u.pathToFileURL(p.resolve(r,'scripts/oracle2/supabase_mcp.mjs')).href);await m.runSupabaseMcp();"
      ]
    },
    "trigger": {
      "args": [
        "/c",
        "${USERPROFILE}\\.config\\ai-devops\\mcp-launch.cmd",
        "cmd",
        "/c",
        "npx",
        "-y",
        "trigger.dev@4.4.6",
        "mcp"
      ],
      "command": "cmd"
    },
    "recall-ai": {
      "args": [
        "/c",
        "${USERPROFILE}\\.config\\ai-devops\\mcp-remote-launch.cmd",
        "https://us-east-1.recall.ai/mcp",
        "op://vibe_coding/recall-ai MCP/password",
        "--transport",
        "http-first"
      ],
      "command": "cmd"
    }
  }
}
