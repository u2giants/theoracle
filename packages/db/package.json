    "verify:document-context-contract": "tsx src/verify-document-context-migration.ts --contract-only",
    "verify:identity-cleanup": "tsx src/verify-identities.ts",
    "verify:identity-cleanup-contract": "tsx src/verify-identity-cleanup-contract.ts",
