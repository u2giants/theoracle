{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "journeyId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "journeyRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "state": {
      "type": "string",
      "enum": [
        "uploading",
        "awaiting_original_reading",
        "awaiting_admission",
        "processing",
        "draft_ready",
        "revision_pending",
        "confirmed_for_scope",
        "answer_ready",
        "cancel_requested",
        "cancelled",
        "failed_spent",
        "error",
        "evidence_missing"
      ]
    },
    "sources": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "sourceId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "originalSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "readingSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "parserId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "workspaceId",
          "sourceId",
          "revision",
          "originalSha256",
          "readingSha256",
          "parserId"
        ],
        "additionalProperties": false
      }
    },
    "model": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "modelId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "version": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "contentHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "ackEventId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "modelId",
            "version",
            "contentHash",
            "ackEventId"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "confirmation": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "workflowId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "version": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "contentHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "current": {
              "type": "boolean"
            }
          },
          "required": [
            "workflowId",
            "version",
            "contentHash",
            "current"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "answer": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32000
            },
            "citations": {
              "minItems": 1,
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "object",
                    "properties": {
                      "workspaceId": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      "sourceId": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      "revision": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "originalSha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "readingSha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "parserId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "required": [
                      "workspaceId",
                      "sourceId",
                      "revision",
                      "originalSha256",
                      "readingSha256",
                      "parserId"
                    ],
                    "additionalProperties": false
                  },
                  "start": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "end": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16000
                  },
                  "pageView": {
                    "type": "object",
                    "properties": {
                      "viewId": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
                      },
                      "pageNumber": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 40
                      },
                      "imageSha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "byteCount": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 26214400
                      },
                      "width": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 20000
                      },
                      "height": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 20000
                      }
                    },
                    "required": [
                      "viewId",
                      "pageNumber",
                      "imageSha256",
                      "byteCount",
                      "width",
                      "height"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "source",
                  "start",
                  "end",
                  "quote"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "text",
            "citations"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "message": {
      "type": "string",
      "maxLength": 1000
    },
    "mapView": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "workflow": {
              "type": "object",
              "properties": {
                "workflow_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "scope": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "completeness": {
                  "type": "string",
                  "enum": [
                    "partial",
                    "complete",
                    "ambiguous",
                    "conflicted"
                  ]
                },
                "steps": {
                  "minItems": 1,
                  "maxItems": 200,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "step_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "activity",
                          "start",
                          "end",
                          "rejection",
                          "call",
                          "return"
                        ]
                      },
                      "role_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "support": {
                        "type": "object",
                        "properties": {
                          "observation_ids": {
                            "minItems": 1,
                            "maxItems": 200,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200
                            }
                          }
                        },
                        "required": [
                          "observation_ids"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "step_id",
                      "label",
                      "kind",
                      "support"
                    ],
                    "additionalProperties": false
                  }
                },
                "gateways": {
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "gateway_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "exclusive_split",
                          "exclusive_join",
                          "parallel_split",
                          "parallel_join",
                          "unsupported"
                        ]
                      },
                      "support": {
                        "type": "object",
                        "properties": {
                          "observation_ids": {
                            "minItems": 1,
                            "maxItems": 200,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200
                            }
                          }
                        },
                        "required": [
                          "observation_ids"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "gateway_id",
                      "kind",
                      "support"
                    ],
                    "additionalProperties": false
                  }
                },
                "transitions": {
                  "maxItems": 500,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "transition_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "from_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "to_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "condition_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "rework": {
                        "type": "boolean"
                      },
                      "support": {
                        "type": "object",
                        "properties": {
                          "observation_ids": {
                            "minItems": 1,
                            "maxItems": 200,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200
                            }
                          }
                        },
                        "required": [
                          "observation_ids"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "transition_id",
                      "from_id",
                      "to_id",
                      "rework",
                      "support"
                    ],
                    "additionalProperties": false
                  }
                },
                "conditions": {
                  "maxItems": 200,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "condition_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "wording": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      },
                      "applicability": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "required": [
                      "condition_id",
                      "wording",
                      "applicability"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "workflow_id",
                "scope",
                "completeness",
                "steps",
                "gateways",
                "transitions",
                "conditions"
              ],
              "additionalProperties": false
            },
            "findings": {
              "maxItems": 1000,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "scope": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "finding_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "missing_information",
                      "source_conflict",
                      "model_incomplete"
                    ]
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "unresolved",
                      "resolved_by_authorized_review",
                      "superseded",
                      "withdrawn",
                      "needs_evidence"
                    ]
                  },
                  "origin": {
                    "type": "string",
                    "enum": [
                      "source_reported",
                      "reported_conflict_unverified",
                      "coverage_inference",
                      "legacy_unverified",
                      "structural_diagnostic"
                    ]
                  },
                  "evidence_refs": {
                    "maxItems": 100,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "ref": {
                          "type": "object",
                          "properties": {
                            "source_id": {
                              "type": "string",
                              "format": "uuid",
                              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                            },
                            "revision": {
                              "type": "integer",
                              "exclusiveMinimum": 0,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": [
                            "source_id",
                            "revision"
                          ],
                          "additionalProperties": false
                        },
                        "start": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "end": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "quote": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 16000
                        }
                      },
                      "required": [
                        "ref",
                        "start",
                        "end",
                        "quote"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "scope",
                  "finding_id",
                  "kind",
                  "text",
                  "status",
                  "origin",
                  "evidence_refs"
                ],
                "additionalProperties": false
              }
            },
            "observations": {
              "minItems": 1,
              "maxItems": 1000,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "observation_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "evidence": {
                    "minItems": 1,
                    "maxItems": 100,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "ref": {
                          "type": "object",
                          "properties": {
                            "source_id": {
                              "type": "string",
                              "format": "uuid",
                              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                            },
                            "revision": {
                              "type": "integer",
                              "exclusiveMinimum": 0,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": [
                            "source_id",
                            "revision"
                          ],
                          "additionalProperties": false
                        },
                        "start": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "end": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "quote": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 16000
                        }
                      },
                      "required": [
                        "ref",
                        "start",
                        "end",
                        "quote"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "observation_id",
                  "evidence"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "workflow",
            "findings",
            "observations"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "journeyId",
    "journeyRevision",
    "state",
    "sources",
    "model",
    "confirmation",
    "answer",
    "message",
    "mapView"
  ],
  "additionalProperties": false
}
