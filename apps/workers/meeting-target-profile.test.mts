import test from 'node:test';
import assert from 'node:assert/strict';
import {mkdtempSync,writeFileSync,chmodSync,rmSync,readFileSync,readdirSync} from 'node:fs';
import {tmpdir} from 'node:os';
import {join} from 'node:path';
import {createHash} from 'node:crypto';
import {canonicalJson} from '@oracle/shared/protected-canonical-json';
import {MEETING_TASK_FILES,resolveMeetingsTriggerProject} from './meeting-target-profile.mjs';
const targets=JSON.parse(readFileSync(new URL('../../tests/fixtures/meeting-targets.json',import.meta.url),'utf8')) as {selected:string;other:string};
const now=Date.parse('2026-10-21T20:00:00Z');
const profile=()=>({schema_version:1,purpose:'oracle2-meetings-trigger-target-v1',project_ref:targets.selected,issuer:'01000000-0000-4000-8000-000000000001',reviewer:'02000000-0000-4000-8000-000000000002',valid_from:'2026-10-21T19:00:00Z',valid_until:'2026-10-21T21:00:00Z',original_horizon:'2026-10-21T22:00:00Z'});
function fixture(change:Record<string,unknown>={},envChange:Record<string,string>={}){const dir=mkdtempSync(join(tmpdir(),'oracle-meeting-target-'));chmodSync(dir,0o700);const path=join(dir,'target.json'),v={...profile(),...change};writeFileSync(path,canonicalJson(v),{mode:0o600});const env={ORACLE2_MEETINGS_TARGET_PATH:path,ORACLE2_MEETINGS_TARGET_SHA256:createHash('sha256').update(canonicalJson(v)).digest('hex'),ORACLE2_MEETINGS_TRIGGER_PROJECT_REF:v.project_ref as string,...envChange};return {env,close:()=>rmSync(dir,{recursive:true,force:true})};}
test('exact independently installed invented descriptor selects configuration only',()=>{const f=fixture();try{assert.equal(resolveMeetingsTriggerProject(f.env,now),profile().project_ref);}finally{f.close();}});
test('absence cannot inherit legacy/default project',()=>{for(const env of [{},{TRIGGER_PROJECT_REF:profile().project_ref}])assert.throws(()=>resolveMeetingsTriggerProject(env,now));});
for(const change of [{schema_version:true},{extra:'unknown'},{issuer:profile().reviewer},{reviewer:'unverified'},{valid_until:'2026-10-21T19:30:00Z'},{valid_from:'2026-10-21T21:00:00Z'},{original_horizon:'2026-10-21T20:30:00Z'},{valid_from:'2026-02-30T01:00:00Z'}])test('closed scope or finite time mismatch refuses '+JSON.stringify(change),()=>{const f=fixture(change);try{assert.throws(()=>resolveMeetingsTriggerProject(f.env,now));}finally{f.close();}});
test('digest, explicit project and all configured previous purpose collisions refuse',()=>{const f=fixture();try{for(const env of [{...f.env,ORACLE2_MEETINGS_TARGET_SHA256:'a'.repeat(64)},{...f.env,ORACLE2_MEETINGS_TRIGGER_PROJECT_REF:targets.other},...['TRIGGER_PROJECT_REF','ORACLE2_OPERATING_TRIGGER_PROJECT_REF','ORACLE2_NATIVE_TRIGGER_PROJECT_REF','ORACLE2_EXTRACT_TRIGGER_PROJECT_REF'].map(k=>({...f.env,[k]:profile().project_ref}))])assert.throws(()=>resolveMeetingsTriggerProject(env,now));}finally{f.close();}});
test('same exact seven tasks excluded from legacy and isolated config has no Python extension',()=>{const old=readFileSync(new URL('./trigger.config.ts',import.meta.url),'utf8'),isolated=readFileSync(new URL('./trigger.oracle2-meetings.config.ts',import.meta.url),'utf8');assert.equal(MEETING_TASK_FILES.length,7);for(const name of MEETING_TASK_FILES)assert.ok(old.includes(`**/${name}`));assert.match(isolated,/!MEETING_TASK_FILES.includes/);assert.match(isolated,/maxAttempts:1/);assert.doesNotMatch(isolated,/oracle2Python|extensions:|readPrivateTarget|TRIGGER_PROJECT_REF/);});
test('actual installed SDK config readback isolates only named meetings tasks with no build extensions',async()=>{const f=fixture({valid_from:'2000-01-01T00:00:00Z',valid_until:'2099-01-01T00:00:00Z',original_horizon:'2099-01-02T00:00:00Z'});const old={...process.env};try{Object.assign(process.env,f.env);const {default:config}=await import('./trigger.oracle2-meetings.config.ts');assert.equal(config.project,profile().project_ref);assert.equal(config.maxDuration,30);assert.equal(config.retries?.default?.maxAttempts,1);assert.deepEqual(config.dirs,['./src/trigger']);assert.ok(!config.build?.extensions?.length);for(const entry of readdirSync(new URL('./src/trigger',import.meta.url),{withFileTypes:true})){if(entry.isDirectory())assert.ok(config.ignorePatterns?.includes('**/'+entry.name+'/**'));else if(!MEETING_TASK_FILES.includes(entry.name))assert.ok(config.ignorePatterns?.includes('**/'+entry.name));}for(const name of MEETING_TASK_FILES)assert.ok(!config.ignorePatterns?.includes('**/'+name));}finally{for(const k of Object.keys(process.env))if(!(k in old))delete process.env[k];Object.assign(process.env,old);f.close();}});
